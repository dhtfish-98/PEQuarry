include .github/workflows/check.yml .gitignore
include DEFENSIVE_SCOPE.md NAME_AUDIT.json README.md ORIGIN.md VALIDATION.md SYMBOL_MAP.json FILE_MAP.json SOURCE_MANIFEST.json CURRENT_REVIEW.json REVIEWED_VERSION_CHANGES.json verify.py
recursive-include src *.py
recursive-include checks *
recursive-include historical_checks *.py
global-exclude *.pyc
global-exclude .DS_Store
prune **/__pycache__
